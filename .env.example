# Base de dados Postgres (obrigatório)
# Na Vercel: separador Storage do projeto → Create Database → Neon (grátis) —
# a variável é injetada automaticamente, não precisa de a definir à mão.
DATABASE_URL=postgres://utilizador:palavra-passe@localhost:5432/cadeiracheia

# Segredo para assinar sessões (obrigatório em produção)
AUTH_SECRET=mude-isto-para-um-segredo-longo-e-aleatorio

# URL pública da aplicação (usada nos redirecionamentos do Stripe)
APP_URL=http://localhost:3000

# Stripe — pagamentos da subscrição Premium (€49/mês)
# Crie um produto "CadeiraCheia Premium" com preço recorrente mensal e copie o ID do preço
STRIPE_SECRET_KEY=sk_live_...
STRIPE_PRICE_ID=price_...
STRIPE_WEBHOOK_SECRET=whsec_...

# SMTP — envio das campanhas de email (qualquer fornecedor: Brevo, Mailgun, Amazon SES, ...)
SMTP_HOST=smtp.exemplo.com
SMTP_PORT=587
SMTP_USER=utilizador
SMTP_PASS=palavra-passe
SMTP_FROM="A Sua Clínica <clinica@exemplo.com>"

# Apenas para demonstrações: permite ativar o plano Premium sem pagamento (1 = ativo)
DEMO_UPGRADE=0
